<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only manifest overlay.

  Allows plain-HTTP API calls to a development machine (e.g. http://192.168.1.10:3002)
  while building/running the debug app. Release builds do NOT get this flag, so the
  production app must talk to an HTTPS backend.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:usesCleartextTraffic="true" />
</manifest>
