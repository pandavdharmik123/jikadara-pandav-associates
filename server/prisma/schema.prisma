// Prisma schema for Advocate Management System
// PostgreSQL + Prisma ORM (Prisma v7+)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────

enum Role {
  ADMIN
  SENIOR
  JUNIOR
}

enum TaskStatus {
  ACTIVE
  DONE
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum OfficeEntryType {
  INCOME
  EXPENSE
}

enum FormBuilderFormKey {
  PAN_NEW_APPLICATION
  PAN_CORRECTION
  MARRIAGE_REGISTRATION
  PROPERTY_TAX_NAME_TRANSFER
}

enum FormBuilderStatus {
  DRAFT
  COMPLETED
  ARCHIVED
}

// ─── User ────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  mobileNumber String   @default("")
  role         Role     @default(JUNIOR)
  isActive     Boolean  @default(true)
  allowedPages String[] @default([])
  twoFactorEnabled Boolean  @default(false)
  twoFactorSecret  String?
  backupCodes      String[] @default([])
  securityPinHash  String?
  emailOtpHash     String?
  emailOtpExpiresAt DateTime?
  mobileOtpHash    String?
  mobileOtpExpiresAt DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  clients         Client[]
  tasks           Task[]
  transactions    TaskTransaction[]
  financialYears  FinancialYear[]
  generalExpenses GeneralExpense[]
  officeLedgerEntries OfficeLedgerEntry[]
  officeSplitUsers OfficeSplitUser[]
  invoices        Invoice[]
  upads           Upad[]
  pedhinamus      Pedhinamu[]
  jantriCalculations JantriCalculation[]
  nondhStatuses   NondhStatus[]
  formBuilderRecords FormBuilderRecord[]
  refreshTokens   RefreshToken[]
}

// ─── Refresh Tokens (sliding sessions) ───────────────────
// Only a SHA-256 hash of each opaque refresh token is stored. Tokens are
// rotated on every use; `familyId` links all rotations of one login so that
// replay of an already-used token can revoke the whole session.
model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  familyId   String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

// ─── Client ──────────────────────────────────────────────

model Client {
  id            String    @id @default(uuid())
  userId        String
  name          String
  referenceName String    @default("")
  mobileNumber  String    @default("")
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks        Task[]
  transactions TaskTransaction[]

  @@index([userId])
  @@index([isDeleted])
  @@index([deletedAt])
}

// ─── Task ────────────────────────────────────────────────

model Task {
  id            String     @id @default(uuid())
  clientId      String?
  clientName    String     @default("")
  userId        String
  documentType  String
  referenceName String     @default("")
  place         String     @default("")
  startDate     DateTime   @default(now())
  completedDate DateTime?
  status        TaskStatus @default(ACTIVE)
  totalIncome   Decimal    @default(0) @db.Decimal(12, 2)
  totalExpense  Decimal    @default(0) @db.Decimal(12, 2)
  netAmount     Decimal    @default(0) @db.Decimal(12, 2)
  isDeleted     Boolean    @default(false)
  deletedAt     DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  client       Client?           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions TaskTransaction[]
  invoices     Invoice[]

  @@index([userId])
  @@index([clientId])
  @@index([status])
  @@index([completedDate])
  @@index([isDeleted])
  @@index([deletedAt])
}

// ─── TaskTransaction ─────────────────────────────────────

model TaskTransaction {
  id            String          @id @default(uuid())
  taskId        String?
  userId        String
  clientId      String?
  clientName    String          @default("")
  documentType  String          @default("")
  place         String          @default("")
  referenceName String          @default("")
  date          DateTime        @default(now())
  type          TransactionType
  description   String          @default("")
  amount        Decimal         @default(0) @db.Decimal(12, 2)
  isDeleted     Boolean         @default(false)
  deletedAt     DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  task   Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
  @@index([clientId])
  @@index([type])
  @@index([date])
  @@index([isDeleted])
  @@index([deletedAt])
}

// ─── DocumentType ────────────────────────────────────────

model DocumentType {
  id        String    @id @default(uuid())
  name      String    @unique
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([isDeleted])
}

model FinancialYear {
  id        String   @id @default(uuid())
  userId    String
  name      String   // e.g. "FY 2024-2025"
  startDate DateTime
  endDate   DateTime
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
}

// ─── GeneralExpense ──────────────────────────────────────

model GeneralExpense {
  id          String    @id @default(uuid())
  userId      String
  date        DateTime  @default(now())
  description String    @default("")
  amount      Decimal   @default(0) @db.Decimal(12, 2)
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isDeleted])
  @@index([deletedAt])
}

// ─── OfficeLedgerEntry (isolated office income/expense ledger) ──

model OfficeLedgerEntry {
  id          String          @id @default(uuid())
  userId      String
  entryType   OfficeEntryType
  entryDate   DateTime
  expenseType String?
  details     String
  amount      Decimal         @default(0) @db.Decimal(12, 2)
  isDeleted   Boolean         @default(false)
  deletedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([entryDate])
  @@index([entryType])
  @@index([isDeleted])
  @@index([deletedAt])
  @@index([userId, entryDate])
}

// ─── OfficeSplitUser (people who share an office expense shortfall) ──

model OfficeSplitUser {
  id        String   @id @default(uuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}

// ─── Invoice ─────────────────────────────────────────────

model Invoice {
  id             String    @id @default(uuid())
  invoiceNo      String
  userId         String
  taskId         String?
  clientName     String
  date           DateTime
  discountAmount Decimal   @default(0) @db.Decimal(12, 2)
  jamaAmount     Decimal   @default(0) @db.Decimal(12, 2)
  subTotal       Decimal   @default(0) @db.Decimal(12, 2)
  total          Decimal   @default(0) @db.Decimal(12, 2)
  balance        Decimal   @default(0) @db.Decimal(12, 2)
  items          Json
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  task           Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([taskId])
  @@index([isDeleted])
  @@index([deletedAt])
}

// ─── Upad (Profit Withdrawal) ────────────────────────────

model Upad {
  id          String    @id @default(uuid())
  userId      String
  userName    String    @default("")
  date        DateTime  @default(now())
  description String    @default("")
  amount      Decimal   @default(0) @db.Decimal(12, 2)
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
  @@index([isDeleted])
  @@index([deletedAt])
}

// ─── Pedhinamu (Dynamic Family Tree Drafts) ─────────────

model Pedhinamu {
  id            String    @id @default(uuid())
  userId        String
  title         String    @default("Untitled Pedhinamu")
  applicantName String    @default("")
  deceasedName  String    @default("")
  documentData  Json
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isDeleted])
  @@index([deletedAt])
}

// ─── JantriCalculation (Saved Jantri & Stamp Duty Calculations) ─────

model JantriCalculation {
  id              String    @id @default(uuid())
  userId          String
  title           String    @default("Untitled Jantri")
  clientName      String    @default("")
  propertyDetails String    @default("")
  village         String    @default("")
  propertyType    String    @default("")
  finalValue      Decimal   @default(0) @db.Decimal(14, 2)
  totalFee        Decimal   @default(0) @db.Decimal(14, 2)
  calculationData Json
  isDeleted       Boolean   @default(false)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isDeleted])
  @@index([deletedAt])
}

// ─── NondhStatus (Revenue Mutation Entry Status Tracking) ─────

model NondhStatus {
  id            String    @id @default(uuid())
  userId        String
  number        Int
  placeName     String    @default("")
  documentType  String    @default("")
  nondhNumber   String    @default("")
  date          DateTime?
  partyName     String    @default("")
  status        String    @default("પ્રમાણિત")
  referenceName String    @default("")
  doneOrNot     String    @default("Done")
  vahivatFee    Decimal?  @db.Decimal(12, 2)
  paymentDate   DateTime?
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isDeleted])
  @@index([deletedAt])
  @@index([number])
}

// ─── FormBuilderRecord (saved Form Builder applications) ─
// Only the typed form fields are stored here. Uploaded photographs,
// signatures and document scans deliberately stay on the user's device.

model FormBuilderRecord {
  id            String            @id @default(uuid())
  userId        String
  formKey       FormBuilderFormKey
  title         String            @default("")
  clientName    String            @default("")
  status        FormBuilderStatus @default(DRAFT)
  data          Json
  schemaVersion Int               @default(1)
  revision      Int               @default(1)
  isDeleted     Boolean           @default(false)
  deletedAt     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, formKey, isDeleted, updatedAt])
  @@index([userId, updatedAt])
}

// ─── BackupRun (Google Drive database backups) ───────────

model BackupRun {
  id            String    @id @default(uuid())
  project       String    @default("advocate-management")
  accountId     String    @default("")
  accountEmail  String    @default("")
  trigger       String    @default("manual")
  status        String    @default("RUNNING")
  fileName      String?
  fileSizeBytes Int?
  driveFileId   String?
  driveWebLink  String?
  sha256        String?
  encrypted     Boolean   @default(false)
  durationMs    Int?
  error         String?
  deletedAt     DateTime?
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?

  @@index([startedAt])
  @@index([status])
  @@index([accountEmail])
}
