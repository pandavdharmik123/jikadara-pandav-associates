// Prisma schema for Advocate Management System
// PostgreSQL + Prisma ORM (Prisma v7+)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────

enum Role {
  ADMIN
  SENIOR
  JUNIOR
}

enum TaskStatus {
  ACTIVE
  DONE
}

enum TransactionType {
  INCOME
  EXPENSE
}

// ─── User ────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  mobileNumber String   @default("")
  role         Role     @default(JUNIOR)
  isActive     Boolean  @default(true)
  allowedPages String[] @default([])
  twoFactorEnabled Boolean  @default(false)
  twoFactorSecret  String?
  backupCodes      String[] @default([])
  securityPinHash  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  clients         Client[]
  tasks           Task[]
  transactions    TaskTransaction[]
  financialYears  FinancialYear[]
  generalExpenses GeneralExpense[]
  invoices        Invoice[]
  upads           Upad[]
}

// ─── Client ──────────────────────────────────────────────

model Client {
  id            String    @id @default(uuid())
  userId        String
  name          String
  referenceName String    @default("")
  mobileNumber  String    @default("")
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks        Task[]
  transactions TaskTransaction[]

  @@index([userId])
  @@index([isDeleted])
  @@index([deletedAt])
}

// ─── Task ────────────────────────────────────────────────

model Task {
  id            String     @id @default(uuid())
  clientId      String?
  clientName    String     @default("")
  userId        String
  documentType  String
  referenceName String     @default("")
  place         String     @default("")
  startDate     DateTime   @default(now())
  completedDate DateTime?
  status        TaskStatus @default(ACTIVE)
  totalIncome   Decimal    @default(0) @db.Decimal(12, 2)
  totalExpense  Decimal    @default(0) @db.Decimal(12, 2)
  netAmount     Decimal    @default(0) @db.Decimal(12, 2)
  isDeleted     Boolean    @default(false)
  deletedAt     DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  client       Client?           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions TaskTransaction[]
  invoices     Invoice[]

  @@index([userId])
  @@index([clientId])
  @@index([status])
  @@index([completedDate])
  @@index([isDeleted])
  @@index([deletedAt])
}

// ─── TaskTransaction ─────────────────────────────────────

model TaskTransaction {
  id            String          @id @default(uuid())
  taskId        String?
  userId        String
  clientId      String?
  clientName    String          @default("")
  documentType  String          @default("")
  place         String          @default("")
  referenceName String          @default("")
  date          DateTime        @default(now())
  type          TransactionType
  description   String          @default("")
  amount        Decimal         @default(0) @db.Decimal(12, 2)
  isDeleted     Boolean         @default(false)
  deletedAt     DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  task   Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
  @@index([clientId])
  @@index([type])
  @@index([date])
  @@index([isDeleted])
  @@index([deletedAt])
}

// ─── DocumentType ────────────────────────────────────────

model DocumentType {
  id        String    @id @default(uuid())
  name      String    @unique
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([isDeleted])
}

model FinancialYear {
  id        String   @id @default(uuid())
  userId    String
  name      String   // e.g. "FY 2024-2025"
  startDate DateTime
  endDate   DateTime
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
}

// ─── GeneralExpense ──────────────────────────────────────

model GeneralExpense {
  id          String    @id @default(uuid())
  userId      String
  date        DateTime  @default(now())
  description String    @default("")
  amount      Decimal   @default(0) @db.Decimal(12, 2)
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isDeleted])
  @@index([deletedAt])
}

// ─── Invoice ─────────────────────────────────────────────

model Invoice {
  id             String    @id @default(uuid())
  invoiceNo      String
  userId         String
  taskId         String?
  clientName     String
  date           DateTime
  discountAmount Decimal   @default(0) @db.Decimal(12, 2)
  jamaAmount     Decimal   @default(0) @db.Decimal(12, 2)
  subTotal       Decimal   @default(0) @db.Decimal(12, 2)
  total          Decimal   @default(0) @db.Decimal(12, 2)
  balance        Decimal   @default(0) @db.Decimal(12, 2)
  items          Json
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  task           Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([taskId])
  @@index([isDeleted])
  @@index([deletedAt])
}

// ─── Upad (Profit Withdrawal) ────────────────────────────

model Upad {
  id          String    @id @default(uuid())
  userId      String
  userName    String    @default("")
  date        DateTime  @default(now())
  description String    @default("")
  amount      Decimal   @default(0) @db.Decimal(12, 2)
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
  @@index([isDeleted])
  @@index([deletedAt])
}
