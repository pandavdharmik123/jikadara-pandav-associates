# ==============================================================================
# Advocate Management & Document AI Backend Environment Variables
# ==============================================================================

PORT=3001
NODE_ENV=development

# ─── Database Configuration ───────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/advocate_management?schema=public"

# ─── Authentication & Security ────────────────────────────────────────────────
JWT_SECRET="replace-with-a-secure-random-secret"

# Sliding sessions: access tokens are short-lived, refresh tokens rotate on use.
ACCESS_TOKEN_TTL="1h"
REFRESH_TOKEN_TTL_DAYS=30
# Multi-tab grace period for a just-rotated refresh token (seconds).
REFRESH_ROTATION_GRACE_SECONDS=60

# ─── Automated PostgreSQL Backup to Google Drive ──────────────────────────────
# Full guide: server/BACKUP.md
#
# Google Drive has no password-based API. You need an OAuth client (once) and a
# refresh token per Google account (one-time consent). Run `npm run backup:auth`.
#
# 1. Create a Google Cloud project and enable the Google Drive API
# 2. OAuth consent screen → External → PUBLISH to "In production"
#    (refresh tokens created in "Testing" expire after 7 days)
# 3. Credentials → Create OAuth Client ID → Desktop app
# 4. Run `npm run backup:auth`, paste the generated values below

# Master switch for the in-process scheduler. Manual/CLI backups still work when false.
GOOGLE_DRIVE_BACKUP_ENABLED=false

# Project name used in filenames and in the Drive folder name.
PROJECT_NAME="advocate-management"

# Shared OAuth client (used by every account unless overridden per account).
GOOGLE_DRIVE_CLIENT_ID=""
GOOGLE_DRIVE_CLIENT_SECRET=""
# Only used by the one-time auth script. Must match the redirect URI in the
# OAuth client settings when it is a "Web application" client.
GOOGLE_DRIVE_REDIRECT_URI="http://localhost:5555/oauth2callback"

# ── Single account (simplest) ────────────────────────────────────────────────
# Leave GOOGLE_DRIVE_ACCOUNTS empty to use this account.
GOOGLE_DRIVE_ACCOUNT_EMAIL=""
GOOGLE_DRIVE_REFRESH_TOKEN=""
# Optional: upload into an existing folder instead of auto-creating
# "My Drive / DB Backups / <PROJECT_NAME>". With the drive.file scope the app
# can only see folders it created itself; a manually created folder requires
# the full https://www.googleapis.com/auth/drive scope.
GOOGLE_DRIVE_BACKUP_FOLDER_ID=""

# ── Multiple accounts (optional) ─────────────────────────────────────────────
# Each id gets its own email + refresh token. Uploads go to every account in
# GOOGLE_DRIVE_BACKUP_ACCOUNTS (or all accounts when empty).
# GOOGLE_DRIVE_ACCOUNTS=primary,office
# GOOGLE_DRIVE_PRIMARY_EMAIL="you@gmail.com"
# GOOGLE_DRIVE_PRIMARY_REFRESH_TOKEN=""
# GOOGLE_DRIVE_PRIMARY_BACKUP_FOLDER_ID=""
# GOOGLE_DRIVE_OFFICE_EMAIL="office@gmail.com"
# GOOGLE_DRIVE_OFFICE_REFRESH_TOKEN=""
# GOOGLE_DRIVE_BACKUP_ACCOUNTS=primary,office

# Parent folder name created in My Drive.
GOOGLE_DRIVE_ROOT_FOLDER_NAME="DB Backups"

# ── Schedule ─────────────────────────────────────────────────────────────────
# Cron: minute hour day-of-month month day-of-week. Default 02:00 daily.
DB_BACKUP_SCHEDULE="0 2 * * *"
DB_BACKUP_TIMEZONE="Asia/Kolkata"
DB_BACKUP_SCHEDULE_ENABLED=true

# ── Dump ─────────────────────────────────────────────────────────────────────
# custom = pg_dump -Fc (smaller, supports pg_restore); plain = SQL + gzip
DB_BACKUP_FORMAT="custom"
# PostgreSQL client binary. Must be the same or newer major version than the server.
PG_DUMP_PATH="pg_dump"
PG_RESTORE_PATH="pg_restore"
PSQL_PATH="psql"
DB_BACKUP_TEMP_DIR="./backups/tmp"
DB_BACKUP_MAX_FILE_MB=500

# ── Retention (keeps the 15 GB account tidy) ─────────────────────────────────
DB_BACKUP_KEEP_DAILY=30
DB_BACKUP_KEEP_WEEKLY=12
DB_BACKUP_KEEP_MONTHLY=12
# Refuse to upload / prune when Drive has less than this much free space.
DB_BACKUP_MIN_FREE_MB=1024

# ── Encryption (strongly recommended for client/legal data) ──────────────────
# AES-256-GCM. 32+ random characters. NEVER upload this key to Drive and never
# commit it. If you lose it, the backups cannot be restored.
# DB_BACKUP_ENCRYPTION_KEY=""

# ── Alerts ───────────────────────────────────────────────────────────────────
# Failure alerts go through the existing Brevo/SMTP configuration.
BACKUP_ALERT_EMAIL=""
DB_BACKUP_ALERT_ON_SUCCESS=false

